# Required
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
STRAVA_CLIENT_ID="replace-with-strava-client-id"
STRAVA_CLIENT_SECRET="replace-with-strava-client-secret"
STRAVA_SYNC_COOLDOWN_MINUTES="5"

# Optional analytics (Umami)
# Leave blank to disable.
NEXT_PUBLIC_UMAMI_SCRIPT_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Optional but recommended for admin operation hardening
# Comma-separated email allowlist
ADMIN_EMAILS="admin@example.com"
